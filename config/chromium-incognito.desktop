[Desktop Entry]
Type=Application
Name=Chromium (Incognito)
Comment=Browse without saving history, cookies or site data
Exec=/usr/local/bin/chromium-incognito %U
Icon=chromium
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
