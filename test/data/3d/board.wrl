#VRML V2.0 utf8
# A board, a chip twice (DEF and USE), a capacitor, and a background: written for TabTop's tests.
Background { skyColor [ 0.2 0.3 0.8 ] groundColor [ 0.3 0.2 0.1 ] }
DEF Board Transform {
  translation 0 0 0
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.1 0.5 0.1 } }
      geometry Box { size 80 1.6 50 }
    }
  ]
}
Transform {
  translation 10 3 5
  rotation 0 1 0 0.785
  children [
    DEF Chip Shape {
      appearance Appearance { material Material { diffuseColor 0.1 0.1 0.1 } }
      geometry IndexedFaceSet {
        coord Coordinate { point [ -5 -1.5 -5, 5 -1.5 -5, 5 -1.5 5, -5 -1.5 5, -5 1.5 -5, 5 1.5 -5, 5 1.5 5, -5 1.5 5 ] }
        coordIndex [ 0 1 2 3 -1, 7 6 5 4 -1, 0 4 5 1 -1, 1 5 6 2 -1, 2 6 7 3 -1, 3 7 4 0 -1 ]
      }
    }
  ]
}
Transform { translation -20 2.3 -10 children [ USE Chip ] }
Transform { translation 25 1.2 15 children [ Shape { appearance Appearance { material Material { diffuseColor 0.8 0.7 0.2 } } geometry Cylinder { radius 2 height 0.8 } } ] }
